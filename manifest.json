{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "downloads", "webRequest", "tabs"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.disneyplus.com/*",
    "*://*.dssott.com/*",
    "*://*.dssedge.com/*",
    "*://*.bamgrid.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "src/shared/formats.js",
        "src/shared/hls.js",
        "src/shared/dash.js",
        "src/shared/filename.js",
        "src/shared/platforms.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/injectors/_common.js", "src/injectors/youtube.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["src/injectors/_common.js", "src/injectors/netflix.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.disneyplus.com/*"],
      "js": ["src/injectors/_common.js", "src/shared/hls.js", "src/injectors/disneyplus.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
